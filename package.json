{
  "name": "project-tango",
  "version": "3.1.1",
  "description": "Local-first MCP server that lets LLM agents inspect, analyze, and manage e-commerce data (products, inventory, orders) over stdio. Zero-config mock data engine included, with a clean interface to swap in live Shopify/Stripe APIs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "project-tango": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test:coverage": "node --import tsx --test --test-global-setup=src/testGlobalSetup.ts --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=94 --test-coverage-functions=96 \"src/**/*.test.ts\"",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "pretest": "npm run typecheck",
    "test": "node --import tsx --test --test-global-setup=src/testGlobalSetup.ts \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ecommerce",
    "ai-tools",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
