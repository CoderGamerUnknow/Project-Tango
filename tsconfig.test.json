{
  // Typechecking for the test suites.
  //
  // `tsconfig.json` excludes `*.test.ts` because they must not be emitted into
  // `dist/`. The side effect was that `tsc --noEmit` never checked them either:
  // a broken test reached the runner and failed as a runtime ReferenceError
  // instead of a compile error. This config typechecks everything without
  // emitting, so the suites are held to the same standard as the source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
